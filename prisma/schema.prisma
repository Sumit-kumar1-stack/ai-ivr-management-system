generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// USER
// ======================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
}

model User {
  id        String    @id @default(cuid())
  fullName  String
  email     String    @unique
  password  String
  role      UserRole  @default(ADMIN)
  phone     String?
  avatar    String?
  isActive  Boolean   @default(true)
  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// CONTACT
// ======================================================

enum ContactStatus {
  PENDING
  CALLED
  ANSWERED
  FAILED
  BLOCKED
}

model Contact {
  id       String        @id @default(cuid())
  fullName String
  phone    String        @unique
  email    String?
  company  String?
  language String        @default("English")
  status   ContactStatus @default(PENDING)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns CampaignContact[]
  calls     Call[]

  @@index([status])
  @@index([createdAt])
}

// ======================================================
// CAMPAIGN
// ======================================================

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum CampaignRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum OutboundCampaignPurpose {
  GENERAL
  REMINDER
  CALLBACK
  FOLLOW_UP
}

// ======================================================
// OMNICHANNEL COMMUNICATION CAMPAIGN
// ======================================================

enum CommunicationTier {
  STANDARD
  PREMIUM
}

enum CommunicationChannel {
  SMS
  WHATSAPP
  AI_VOICE
  IVR
}

enum CommunicationFallbackPolicy {
  NONE
  WHATSAPP_TO_SMS
  OMNICHANNEL
}

enum CommunicationCampaignStatus {
  DRAFT
  READY
  SCHEDULED
  QUEUED
  RUNNING
  DISPATCHED
  COMPLETED
  FAILED
  CANCELLED
}

enum CommunicationRecipientStatus {
  PENDING
  PROCESSING
  DISPATCHED
  COMPLETED
  FAILED
  SKIPPED
}

// ======================================================
// EXISTING VOICE CAMPAIGN
// ======================================================

model Campaign {
  id          String  @id @default(cuid())
  name        String
  description String?

  systemKey String? @unique

  language String  @default("English")
  voice    String  @default("Female")
  prompt   String?

  purpose OutboundCampaignPurpose @default(GENERAL)

  status CampaignStatus @default(DRAFT)

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts CampaignContact[]
  calls    Call[]
  runs     CampaignRun[]

  // ----------------------------------------------------
  // OmniConnect child-campaign relationships
  // ----------------------------------------------------

  communicationVoiceParent CommunicationCampaign? @relation("CommunicationVoiceCampaign")
  communicationIvrParent   CommunicationCampaign? @relation("CommunicationIvrCampaign")

  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
}

// ======================================================
// COMMUNICATION CAMPAIGN
// ======================================================

model CommunicationCampaign {
  id String @id @default(cuid())

  name String

  // ----------------------------------------------------
  // Audience boundary
  // ----------------------------------------------------

  audienceSourceId   String?
  audienceSourceName String
  recipientCount     Int     @default(0)

  // ----------------------------------------------------
  // Subscription snapshot
  // ----------------------------------------------------

  tier CommunicationTier @default(STANDARD)

  // ----------------------------------------------------
  // Channels
  // ----------------------------------------------------

  channels CommunicationChannel[]

  smartChanneling Boolean @default(false)

  fallbackPolicy CommunicationFallbackPolicy @default(NONE)

  // ----------------------------------------------------
  // Lifecycle
  // ----------------------------------------------------

  status CommunicationCampaignStatus @default(DRAFT)

  launchImmediately Boolean @default(true)

  scheduledAt DateTime?

  // ----------------------------------------------------
  // AI Voice child campaign
  // ----------------------------------------------------

  voiceCampaignId String?   @unique
  voiceCampaign   Campaign? @relation("CommunicationVoiceCampaign", fields: [voiceCampaignId], references: [id], onDelete: SetNull)

  // ----------------------------------------------------
  // Classic IVR child campaign
  // ----------------------------------------------------

  ivrCampaignId String?   @unique
  ivrCampaign   Campaign? @relation("CommunicationIvrCampaign", fields: [ivrCampaignId], references: [id], onDelete: SetNull)

  // ----------------------------------------------------
  // Operator-selected source IVR flow
  // ----------------------------------------------------

  ivrFlowId String?
  ivrFlow   IVRFlow? @relation("CommunicationSelectedIvrFlow", fields: [ivrFlowId], references: [id], onDelete: SetNull)

  // ----------------------------------------------------
  // Runtime IVR snapshot
  // ----------------------------------------------------

  ivrRuntimeFlowId String?  @unique
  ivrRuntimeFlow   IVRFlow? @relation("CommunicationRuntimeIvrFlow", fields: [ivrRuntimeFlowId], references: [id], onDelete: SetNull)

  // ----------------------------------------------------
  // Communication execution
  // ----------------------------------------------------

  recipients        CommunicationCampaignRecipient[]
  messages          OutboundMessage[]
  usageReservations CommunicationCampaignUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([tier])
  @@index([scheduledAt])
  @@index([ivrFlowId])
  @@index([createdAt])
}

model CommunicationCampaignUsage {
  id String @id @default(cuid())

  campaignId String
  campaign   CommunicationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Subscription tier snapshot used for quota accounting.
  tier CommunicationTier

  // UTC calendar day whose allowance this launch consumes.
  usageDate DateTime @db.Date

  recipientCount Int

  reservedAt DateTime  @default(now())
  releasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, usageDate])
  @@index([tier, usageDate, releasedAt])
  @@index([campaignId])
}

model CommunicationCampaignRecipient {
  id String @id @default(cuid())

  campaignId String

  campaign CommunicationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  externalRecipientId String?

  fullName String?

  phone String

  language String @default("English")

  status CommunicationRecipientStatus @default(PENDING)

  lastError String?

  messages OutboundMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, phone])
  @@index([campaignId])
  @@index([phone])
  @@index([status])
}

// ======================================================
// CAMPAIGN CONTACT
// ======================================================

model CampaignContact {
  id String @id @default(cuid())

  campaignId String
  contactId  String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([campaignId, contactId])
  @@index([campaignId])
  @@index([contactId])
}

// ======================================================
// CAMPAIGN RUN
// ======================================================

model CampaignRun {
  id         String            @id @default(cuid())
  campaignId String
  status     CampaignRunStatus @default(QUEUED)

  total      Int @default(0)
  processed  Int @default(0)
  successful Int @default(0)
  failed     Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  calls Call[]

  @@index([campaignId])
  @@index([campaignId, status])
  @@index([status])
}

// ======================================================
// IVR FLOW
// ======================================================

model IVRFlow {
  id String @id @default(cuid())

  name        String
  description String?
  campaignId  String?

  nodes Json
  edges Json

  isPublished Boolean @default(false)
  version     Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ----------------------------------------------------
  // OmniConnect IVR relationships
  // ----------------------------------------------------

  selectedByCommunicationCampaigns CommunicationCampaign[] @relation("CommunicationSelectedIvrFlow")

  runtimeForCommunicationCampaign CommunicationCampaign? @relation("CommunicationRuntimeIvrFlow")

  @@index([campaignId])
  @@index([isPublished])
}

// ======================================================
// KNOWLEDGE BASE
// ======================================================

model KnowledgeDocument {
  id String @id @default(cuid())

  fileName     String
  originalName String
  mimeType     String
  size         Int
  path         String

  uploadedAt DateTime @default(now())

  chunks KnowledgeChunk[]

  @@index([uploadedAt])
}

model KnowledgeChunk {
  id String @id @default(cuid())

  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex Int
  content    String

  createdAt DateTime @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

// ======================================================
// CALL
// ======================================================

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  QUEUED
  RINGING
  ANSWERED
  COMPLETED
  FAILED
  BUSY
  NO_ANSWER
  CANCELED
}

model Call {
  id             String  @id @default(cuid())
  providerCallId String? @unique

  direction CallDirection @default(OUTBOUND)

  callerNumber String?
  calledNumber String?

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  campaignRunId String?
  campaignRun   CampaignRun? @relation(fields: [campaignRunId], references: [id], onDelete: SetNull)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // ====================================================
  // RETRY TRACKING
  // ====================================================

  retryOfCallId String?
  retryOfCall   Call?   @relation("CallRetries", fields: [retryOfCallId], references: [id], onDelete: SetNull)
  retryAttempts Call[]  @relation("CallRetries")

  attemptNumber Int @default(1)
  maxAttempts   Int @default(3)

  nextRetryAt DateTime?
  retryReason String?

  // ====================================================
  // DESTINATION TRACKING
  // ====================================================

  contactPhoneSnapshot      String?
  providerDestination       String?
  usedDevelopmentOverride   Boolean @default(false)
  destinationOverrideSource String?

  language String

  status CallStatus @default(QUEUED)

  duration     Int?
  recordingUrl String?
  transcript   String?
  summary      String?

  events CallEvent[]

  // ====================================================
  // CALL LIFECYCLE TIMESTAMPS
  // ====================================================

  requestedAt DateTime  @default(now())
  queuedAt    DateTime?
  ringingAt   DateTime?
  answeredAt  DateTime?
  completedAt DateTime?
  failedAt    DateTime?

  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation?

  @@unique([campaignRunId, contactId, attemptNumber])
  @@index([campaignId])
  @@index([campaignRunId])
  @@index([campaignRunId, contactId])
  @@index([contactId])
  @@index([retryOfCallId])
  @@index([nextRetryAt])
  @@index([providerDestination])
  @@index([direction])
  @@index([callerNumber])
  @@index([calledNumber])
  @@index([status])
  @@index([requestedAt])
  @@index([answeredAt])
  @@index([completedAt])
}

// ======================================================
// CONVERSATION
// ======================================================

enum ConversationRole {
  SYSTEM
  USER
  ASSISTANT
}

model Conversation {
  id String @id @default(cuid())

  callId String @unique
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  summary   String?
  intent    String?
  sentiment String?
  priority  String?

  followUp Boolean @default(false)

  actionItems Json?

  tokenUsage Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ConversationMessage[]

  @@index([createdAt])
}

model ConversationMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    ConversationRole
  content String

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([role])
}

// ======================================================
// CALL EVENTS
// ======================================================

enum CallEventType {
  STARTED
  RINGING
  ANSWERED
  THINKING
  SPEAKING
  LISTENING
  INTERRUPTED
  COMPLETED
  FAILED
}

model CallEvent {
  id String @id @default(cuid())

  callId String
  type   CallEventType

  message  String?
  payload  Json?
  metadata Json?

  createdAt DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([type])
  @@index([createdAt])
  @@index([callId, createdAt])
}

// ======================================================
// CALLBACK REQUEST
// ======================================================

enum CallbackRequestStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  CANCELLED
  FAILED
}

model CallbackRequest {
  id String @id @default(cuid())

  callId String

  phone String

  requestedAt DateTime @default(now())

  scheduledFor DateTime

  timezone String

  reason String?

  status CallbackRequestStatus @default(REQUESTED)

  idempotencyKey String @unique

  requestedBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([callId])
  @@index([phone])
  @@index([scheduledFor])
  @@index([status])
  @@index([createdAt])
}

// ======================================================
// BUSINESS TOOL EXECUTION
// ======================================================

enum ToolExecutionStatus {
  STARTED
  SUCCEEDED
  FAILED
  ABORTED
  TIMED_OUT
}

model ToolExecution {
  id String @id @default(cuid())

  callId String

  tool String

  requestedBy String

  tenantId String?

  idempotencyKey String?

  status ToolExecutionStatus @default(STARTED)

  requiresConfirmation Boolean @default(false)
  confirmed            Boolean @default(false)

  mutating Boolean @default(false)

  durationMs Int?

  errorCode    String?
  errorMessage String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tool, idempotencyKey])
  @@index([callId])
  @@index([tool])
  @@index([status])
  @@index([createdAt])
  @@index([callId, createdAt])
}

// ======================================================
// LEAD
// ======================================================

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  CONVERTED
  CLOSED
}

model Lead {
  id String @id @default(cuid())

  callId String

  fullName String?

  phone String?

  email String?

  interest String

  notes String?

  status LeadStatus @default(NEW)

  source String @default("AI_IVR")

  idempotencyKey String @unique

  createdBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([callId])
  @@index([status])
  @@index([phone])
  @@index([email])
  @@index([createdAt])
}

// ======================================================
// MESSAGING
// ======================================================

enum MessagingChannel {
  SMS
  WHATSAPP
}

enum MessageConsentStatus {
  OPTED_IN
  OPTED_OUT
  UNKNOWN
}

enum OutboundMessageStatus {
  PROCESSING
  ACCEPTED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  UNDELIVERED
}

model MessageConsent {
  id String @id @default(cuid())

  phone String

  channel MessagingChannel

  status MessageConsentStatus @default(UNKNOWN)

  source String?

  consentedAt DateTime?
  revokedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phone, channel])
  @@index([phone])
  @@index([channel])
  @@index([status])
}

model OutboundMessage {
  id String @id @default(cuid())

  callId String?

  communicationCampaignId String?

  communicationCampaign CommunicationCampaign? @relation(fields: [communicationCampaignId], references: [id], onDelete: SetNull)

  communicationRecipientId String?

  communicationRecipient CommunicationCampaignRecipient? @relation(fields: [communicationRecipientId], references: [id], onDelete: SetNull)

  channel MessagingChannel

  provider String

  recipient String

  templateKey String

  idempotencyKey String @unique

  providerMessageId String? @unique

  status OutboundMessageStatus @default(PROCESSING)

  errorCode    String?
  errorMessage String?

  acceptedAt  DateTime?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([callId])
  @@index([communicationCampaignId])
  @@index([communicationRecipientId])
  @@index([channel])
  @@index([recipient])
  @@index([status])
  @@index([createdAt])
}

// ======================================================
// CONSENT EVIDENCE / HISTORY
// ======================================================

enum ConsentEvidenceAction {
  OPT_IN
  OPT_OUT
}

model ConsentEvidence {
  id String @id @default(cuid())

  phone   String
  channel MessagingChannel

  action ConsentEvidenceAction

  source String

  callId String?

  requestedBy String?

  evidenceText String?

  previousStatus  MessageConsentStatus?
  resultingStatus MessageConsentStatus

  idempotencyKey String? @unique

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([phone])
  @@index([channel])
  @@index([action])
  @@index([callId])
  @@index([occurredAt])
  @@index([phone, channel, occurredAt])
}
