generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// USER
// ======================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
}

model User {
  id        String    @id @default(cuid())
  fullName  String
  email     String    @unique
  password  String
  role      UserRole  @default(ADMIN)
  phone     String?
  avatar    String?
  isActive  Boolean   @default(true)
  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// CONTACT
// ======================================================

enum ContactStatus {
  PENDING
  CALLED
  ANSWERED
  FAILED
  BLOCKED
}

model Contact {
  id       String        @id @default(cuid())
  fullName String
  phone    String        @unique
  email    String?
  company  String?
  language String        @default("English")
  status   ContactStatus @default(PENDING)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns CampaignContact[]
  calls     Call[]

  @@index([status])
  @@index([createdAt])
}

// ======================================================
// CAMPAIGN
// ======================================================

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum CampaignRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Campaign {
  id          String  @id @default(cuid())
  name        String
  description String?

  language String  @default("English")
  voice    String  @default("Female")
  prompt   String?

  status CampaignStatus @default(DRAFT)

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts CampaignContact[]
  calls    Call[]
  runs     CampaignRun[]

  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
}

model CampaignContact {
  id String @id @default(cuid())

  campaignId String
  contactId  String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([campaignId, contactId])
  @@index([campaignId])
  @@index([contactId])
}

model CampaignRun {
  id         String            @id @default(cuid())
  campaignId String
  status     CampaignRunStatus @default(QUEUED)

  total      Int @default(0)
  processed  Int @default(0)
  successful Int @default(0)
  failed     Int @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  calls Call[]

  @@index([campaignId])
  @@index([campaignId, status])
  @@index([status])
}

// ======================================================
// IVR FLOW
// ======================================================

model IVRFlow {
  id String @id @default(cuid())

  name        String
  description String?
  campaignId  String?

  nodes Json
  edges Json

  isPublished Boolean @default(false)
  version     Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([isPublished])
}

// ======================================================
// KNOWLEDGE BASE
// ======================================================

model KnowledgeDocument {
  id String @id @default(cuid())

  fileName     String
  originalName String
  mimeType     String
  size         Int
  path         String

  uploadedAt DateTime @default(now())

  chunks KnowledgeChunk[]

  @@index([uploadedAt])
}

model KnowledgeChunk {
  id String @id @default(cuid())

  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex Int
  content    String

  createdAt DateTime @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

// ======================================================
// CALL
// ======================================================

enum CallStatus {
  QUEUED
  RINGING
  ANSWERED
  COMPLETED
  FAILED
  BUSY
  NO_ANSWER
  CANCELED
}

model Call {
  id             String  @id @default(cuid())
  providerCallId String? @unique

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  campaignRunId String?
  campaignRun   CampaignRun? @relation(fields: [campaignRunId], references: [id], onDelete: SetNull)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // ====================================================
  // RETRY TRACKING
  // ====================================================

  retryOfCallId String?
  retryOfCall   Call?   @relation("CallRetries", fields: [retryOfCallId], references: [id], onDelete: SetNull)
  retryAttempts Call[]  @relation("CallRetries")

  attemptNumber Int @default(1)
  maxAttempts   Int @default(3)

  nextRetryAt DateTime?
  retryReason String?

  // ====================================================
  // DESTINATION TRACKING
  // ====================================================

  contactPhoneSnapshot      String?
  providerDestination       String?
  usedDevelopmentOverride   Boolean @default(false)
  destinationOverrideSource String?

  language String

  status CallStatus @default(QUEUED)

  duration     Int?
  recordingUrl String?
  transcript   String?
  summary      String?

  events CallEvent[]

  // ====================================================
  // CALL LIFECYCLE TIMESTAMPS
  // ====================================================

  requestedAt DateTime  @default(now())
  queuedAt    DateTime?
  ringingAt   DateTime?
  answeredAt  DateTime?
  completedAt DateTime?
  failedAt    DateTime?

  // Temporary compatibility fields.
  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation?

  /**
   * A contact may have multiple call attempts in one
   * campaign run, but each attempt number must be unique.
   */
  @@unique([campaignRunId, contactId, attemptNumber])
  @@index([campaignId])
  @@index([campaignRunId])
  @@index([campaignRunId, contactId])
  @@index([contactId])
  @@index([retryOfCallId])
  @@index([nextRetryAt])
  @@index([providerDestination])
  @@index([status])
  @@index([requestedAt])
  @@index([answeredAt])
  @@index([completedAt])
}

// ======================================================
// CONVERSATION
// ======================================================

enum ConversationRole {
  SYSTEM
  USER
  ASSISTANT
}

model Conversation {
  id String @id @default(cuid())

  callId String @unique
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  summary   String?
  intent    String?
  sentiment String?
  priority  String?

  followUp Boolean @default(false)

  actionItems Json?

  tokenUsage Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ConversationMessage[]

  @@index([createdAt])
}

model ConversationMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    ConversationRole
  content String

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([role])
}

// ======================================================
// CALL EVENTS
// ======================================================

enum CallEventType {
  STARTED
  RINGING
  ANSWERED
  THINKING
  SPEAKING
  LISTENING
  INTERRUPTED
  COMPLETED
  FAILED
}

model CallEvent {
  id String @id @default(cuid())

  callId String
  type   CallEventType

  message  String?
  payload  Json?
  metadata Json?

  createdAt DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([type])
  @@index([createdAt])
  @@index([callId, createdAt])
}
