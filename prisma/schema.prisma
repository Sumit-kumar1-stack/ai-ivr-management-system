generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
}

model User {
  id        String    @id @default(cuid())
  fullName  String
  email     String    @unique
  password  String
  role      UserRole  @default(ADMIN)
  phone     String?
  avatar    String?
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum ContactStatus {
  PENDING
  CALLED
  ANSWERED
  FAILED
  BLOCKED
}

model Contact {
  id       String        @id @default(cuid())
  fullName String
  phone    String        @unique
  email    String?
  company  String?
  language String        @default("English")
  status   ContactStatus @default(PENDING)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns CampaignContact[]
  calls     Call[]
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

model Campaign {
  id          String  @id @default(cuid())
  name        String
  description String?

  language String  @default("English")
  voice    String  @default("Female")
  prompt   String?

  status CampaignStatus @default(DRAFT)

  scheduledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts CampaignContact[]
  calls    Call[]
}

model CampaignContact {
  id String @id @default(cuid())

  campaignId String
  contactId  String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([campaignId, contactId])
}

model IVRFlow {
  id String @id @default(cuid())

  name        String
  description String?
  campaignId  String?

  nodes Json
  edges Json

  isPublished Boolean @default(false)
  version     Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KnowledgeDocument {
  id String @id @default(cuid())

  fileName     String
  originalName String
  mimeType     String
  size         Int
  path         String

  uploadedAt DateTime @default(now())

  chunks KnowledgeChunk[]
}

model KnowledgeChunk {
  id String @id @default(cuid())

  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex Int
  content    String

  createdAt DateTime @default(now())
}

enum CallStatus {
  QUEUED
  RINGING
  ANSWERED
  COMPLETED
  FAILED
  BUSY
  NO_ANSWER
  CANCELED
}

enum ConversationRole {
  SYSTEM
  USER
  ASSISTANT
}

model Call {
  id             String  @id @default(cuid())
  providerCallId String?

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  phone    String
  language String

  status CallStatus @default(QUEUED)

  duration     Int?
  recordingUrl String?
  transcript   String?
  summary      String?

  events CallEvent[]

  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation?
}

model Conversation {
  id String @id @default(cuid())

  callId String @unique
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  summary   String?
  intent    String?
  sentiment String?
  priority  String?

  followUp Boolean @default(false)

  actionItems Json?

  tokenUsage Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ConversationMessage[]
}

model ConversationMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    ConversationRole
  content String

  createdAt DateTime @default(now())
}

enum CallEventType {
  STARTED
  RINGING
  ANSWERED
  THINKING
  SPEAKING
  LISTENING
  INTERRUPTED
  COMPLETED
  FAILED
}

model CallEvent {
  id String @id @default(cuid())

  callId String

  type CallEventType

  message String?

  metadata Json?

  createdAt DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([type])
  @@index([createdAt])
}
