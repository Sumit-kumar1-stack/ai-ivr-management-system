# Select exactly one primary telephony provider.
TELEPHONY_PROVIDER=plivo

# Plivo (required only when TELEPHONY_PROVIDER=plivo). Plivo V3 validates
# webhooks with PLIVO_AUTH_TOKEN; do not configure a second shared secret.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_CALLER_ID=
PLIVO_PUBLIC_BASE_URL=https://your-public-app.example
PLIVO_MEDIA_PUBLIC_URL=wss://your-media-service.example

# Twilio (required only when TELEPHONY_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_PUBLIC_BASE_URL=https://your-public-app.example
TWILIO_MEDIA_PUBLIC_URL=wss://your-media-service.example

# Exotel Voice v1 (required only when TELEPHONY_PROVIDER=exotel)
# EXOTEL_SUBDOMAIN is the API hostname, e.g. api.in.exotel.com (no protocol).
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLER_ID=
EXOTEL_PUBLIC_BASE_URL=https://your-public-app.example
# Use a long random secret and configure it in every Exotel webhook URL.
EXOTEL_WEBHOOK_SECRET=
# AgentStream media (required by the MEDIA process with TELEPHONY_PROVIDER=exotel).
# This must be the public WS(S) origin that terminates at /api/exotel/stream.
EXOTEL_MEDIA_PUBLIC_URL=wss://your-media-service.example
# Configure these same Basic credentials in the Exotel VoiceBot/AgentStream applet.
EXOTEL_STREAM_USERNAME=
EXOTEL_STREAM_PASSWORD=

# Governance Testing Override (Development/testing only. Must never be true in production).
ALLOW_SUPER_ADMIN_SELF_APPROVAL=false

# Messaging Providers (Phase M1, M2 & M3: Provider-Neutral Messaging Abstraction)
# Default SMS provider is twilio. Supported: twilio, plivo, exotel
# SMS_PROVIDER=twilio
# WHATSAPP_PROVIDER=meta

# Plivo SMS (required only when SMS_PROVIDER=plivo; independent of Plivo Voice):
# PLIVO_SMS_FROM=

# Exotel SMS (required only when SMS_PROVIDER=exotel; independent of Exotel Voice):
# EXOTEL_SMS_FROM=





